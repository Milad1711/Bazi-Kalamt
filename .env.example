# ============ Word Game 3D — environment template ============
# Copy to .env (git-ignored) and fill in the real values.

# ---- Database: Neon PostgreSQL (free plan) ----
# Neon dashboard → project → "Connect" → copy the connection string.
# Use the POOLED url (-pooler) if you ever hit "too many connections".
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-YYYY.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Admin panel fallback password (کادر امن) ----
# Needed for the FIRST /admin login only; rotate it immediately from
# /admin ▸ «امنیت» — the rotated password is stored scrypt-hashed in the DB
# and this env value stops mattering.
ADMIN_TOKEN="pick-a-strong-password"
